# Required — get free key at console.groq.com
GROQ_API_KEY=gsk_...

# Twitter — get a free key at twitterapi.io (pay-as-you-go, ~$0.15/1K tweets)
TWITTERAPI_IO_KEY=

# Twitter policy — keep API-only scraping enabled so the system never falls
# back to browser automation or cookie-based collection.
TWITTER_API_ONLY=true

# Twitter — twikit FREE fallback (just a regular X account, no API key needed)
# pip install twikit  |  https://github.com/d60/twikit
# After first login via the UI, cookies are auto-saved and the password is no longer needed.
TWITTER_USERNAME=       # your X username or email
TWITTER_PASSWORD=       # your X password

# Twitter — twscrape (manual cookie extraction, fallback after twikit)
TWSCRAPE_ACCOUNTS_DB=./data/accounts.db

# Optional: LinkedIn credentials (skipped if absent)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Optional: GitHub token (60 req/hr without it, 5000 with)
GITHUB_TOKEN=

# Optional: Brave Search API key — more reliable than DuckDuckGo (free 2K queries/month)
# Get a key at https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=

# Behavior tuning
MAX_TWEETS=200
MAX_WEB_PAGES=20
CACHE_TTL_HOURS=24
OUTPUT_DIR=./outputs
MAX_CONTEXT_TOKENS=150000

# LLM (Groq — swap to anthropic later)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_RETRIES=3
